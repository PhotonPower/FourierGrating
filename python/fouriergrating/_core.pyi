from typing import Any, Optional

class FourierGratingError(RuntimeError): ...

def version() -> str: ...
def variant() -> str: ...
def cuda_available() -> bool: ...
def cad_available() -> bool: ...
def cad_report(config_json: str, base_dir: str = "", step_text: str = "") -> str: ...
def cad_preview(config_json: str, base_dir: str, step_text: str, y_um: float) -> str: ...
def cad_llm_tool_spec() -> str: ...
def solve(config_json: str, profile: bool = False) -> dict[str, Any]: ...
def solve_scan(config_json: str, profile: bool = False) -> list[dict[str, Any]]: ...
def near_field(config_json: str) -> dict[str, Any]: ...

class Simulation:
    def __init__(self, config_json: str) -> None: ...
    def solve(
        self,
        lambda_um: Optional[float] = None,
        phi_deg: Optional[float] = None,
        psi_deg: Optional[float] = None,
        delta_deg: Optional[float] = None,
    ) -> dict[str, Any]: ...
    def set_parameter(self, pointer: str, value: float) -> None: ...
    def value_and_grad(
        self,
        weights: list[tuple[str, int, int, float]],
        params: list[str],
        lambda_um: Optional[float] = None,
        phi_deg: Optional[float] = None,
        psi_deg: Optional[float] = None,
        delta_deg: Optional[float] = None,
    ) -> dict[str, Any]: ...
    def vjp(self, cotangents: list[tuple[str, int, int, float]], params: list[str]) -> list[float]: ...
    def config_json(self) -> str: ...
    @property
    def model_builds(self) -> int: ...
