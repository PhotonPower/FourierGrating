from typing import Any, Optional

class FourierGratingError(RuntimeError): ...

def version() -> str: ...
def variant() -> str: ...
def cuda_available() -> bool: ...
def solve(config_json: str) -> dict[str, Any]: ...
def solve_scan(config_json: str) -> list[dict[str, Any]]: ...
def near_field(config_json: str) -> dict[str, Any]: ...

class Simulation:
    def __init__(self, config_json: str) -> None: ...
    def solve(
        self,
        lambda_um: Optional[float] = None,
        phi_deg: Optional[float] = None,
        psi_deg: Optional[float] = None,
        delta_deg: Optional[float] = None,
    ) -> dict[str, Any]: ...
    def set_parameter(self, pointer: str, value: float) -> None: ...
    def config_json(self) -> str: ...
    @property
    def model_builds(self) -> int: ...
