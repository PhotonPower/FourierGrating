{
  "version": 6,
  "configurePresets": [
    {
      "name": "cpu-release",
      "displayName": "CPU only, Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FG_ENABLE_CUDA": "OFF" }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU only, Debug + sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpu-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug", "FG_ENABLE_CUDA": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CUDA (RTX 6000 Ada, sm_89), Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cuda-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "FG_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "win-release",
      "displayName": "Windows (MSYS2 UCRT64 GCC), CPU only, Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "FG_ENABLE_CUDA": "OFF",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      },
      "environment": { "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}" }
    },
    {
      "name": "win-cuda",
      "displayName": "Windows (MSYS2 UCRT64 GCC) + CUDA, Release (experimental)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-cuda",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "FG_ENABLE_CUDA": "ON",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      },
      "environment": { "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}" }
    }
,
    {
      "name": "cpu-cad",
      "displayName": "CPU only, Release, CAD slicer (Nurbforge)",
      "inherits": "cpu-release",
      "binaryDir": "${sourceDir}/build/cpu-cad",
      "cacheVariables": { "FG_ENABLE_NURBFORGE": "ON" }
    },
    {
      "name": "win-cad",
      "displayName": "Windows (MSYS2 UCRT64 GCC), CPU, Release, CAD slicer (Nurbforge)",
      "inherits": "win-release",
      "binaryDir": "${sourceDir}/build/win-cad",
      "cacheVariables": { "FG_ENABLE_NURBFORGE": "ON" }
    },
    {
      "name": "win-msvc",
      "displayName": "Windows (MSVC 2022, Developer PowerShell / vcvars64), CPU only, Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win-msvc",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release", "FG_ENABLE_CUDA": "OFF",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "win-msvc-cuda",
      "displayName": "Windows (MSVC 2022) + CUDA (RTX 3090 sm_86, RTX 6000 Ada sm_89), Release",
      "inherits": "win-msvc",
      "binaryDir": "${sourceDir}/build/win-msvc-cuda",
      "cacheVariables": { "FG_ENABLE_CUDA": "ON", "CMAKE_CUDA_ARCHITECTURES": "86;89" }
    }
  ],
  "buildPresets": [
    { "name": "cpu-release",  "configurePreset": "cpu-release" },
    { "name": "cpu-debug",    "configurePreset": "cpu-debug" },
    { "name": "cuda-release", "configurePreset": "cuda-release" },
    { "name": "win-release",  "configurePreset": "win-release" },
    { "name": "win-cuda",     "configurePreset": "win-cuda" },
    { "name": "cpu-cad",      "configurePreset": "cpu-cad" },
    { "name": "win-cad",      "configurePreset": "win-cad" },
    { "name": "win-msvc",     "configurePreset": "win-msvc" },
    { "name": "win-msvc-cuda","configurePreset": "win-msvc-cuda" }
  ],
  "testPresets": [
    { "name": "cpu-release", "configurePreset": "cpu-release", "output": { "outputOnFailure": true } },
    { "name": "cpu-debug",   "configurePreset": "cpu-debug",   "output": { "outputOnFailure": true } },
    { "name": "cuda-release","configurePreset": "cuda-release","output": { "outputOnFailure": true } },
    { "name": "win-release", "configurePreset": "win-release", "output": { "outputOnFailure": true } },
    { "name": "win-cuda",    "configurePreset": "win-cuda",    "output": { "outputOnFailure": true } },
    { "name": "cpu-cad",     "configurePreset": "cpu-cad",     "output": { "outputOnFailure": true } },
    { "name": "win-cad",     "configurePreset": "win-cad",     "output": { "outputOnFailure": true } },
    { "name": "win-msvc",    "configurePreset": "win-msvc",    "output": { "outputOnFailure": true } },
    { "name": "win-msvc-cuda","configurePreset": "win-msvc-cuda","output": { "outputOnFailure": true } }
  ]
}
